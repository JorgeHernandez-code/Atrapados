# Copia este archivo como .env.local y completa los valores.
# NUNCA pongas aquí la "service_role key" de Supabase: el frontend solo usa la clave pública (anon / publishable).

# URL del proyecto Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=

# Clave pública "anon" o "publishable" (Project Settings → API). Es segura en el navegador
# SOLO porque las políticas RLS de supabase/migrations impiden leer o modificar contactos.
VITE_SUPABASE_ANON_KEY=

# URL pública definitiva de la aplicación (se usa en mensajes para compartir y en el código QR).
# Ejemplo: https://atrapados.netlify.app
VITE_PUBLIC_SITE_URL=

# Métricas anónimas en Supabase (tabla quiz_events). "true" para activarlas.
VITE_ANALYTICS_ENABLED=false
